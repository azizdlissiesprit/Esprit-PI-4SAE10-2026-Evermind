pipeline {
    agent any
    parameters {
        string(name: 'IMAGE_VERSION', defaultValue: 'latest', description: 'Enter tag to deploy')
    }
    environment {
        DOCKER_IMAGE = "azizesp/intervention-service"
        DEPLOY_TAG = "${params.IMAGE_VERSION}"
    }
    stages {
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Using the folder structure you confirmed earlier
                    sh "kubectl apply -f Backend/k8s/intervention-service-deployment.yaml"

                    // Force the deployment to use the new image version
                    sh "kubectl set image deployment/intervention-service intervention-service=${DOCKER_IMAGE}:${DEPLOY_TAG}"

                    // Ensure the pods start correctly on aziz or rima
                    sh "kubectl rollout status deployment/intervention-service"
                }
            }
        }
    }
}