pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_VERSION', defaultValue: 'latest', description: 'Docker tag to deploy')
    }

    environment {
        DOCKER_IMAGE = "azizesp/evermind-formation"
        DEPLOY_TAG = "${params.IMAGE_VERSION}"
    }

    stages {
        stage('Deploy to K8s') {
            steps {
                script {
                    sh "docker pull ${DOCKER_IMAGE}:${DEPLOY_TAG}"
                    
                    dir('Backend/k8s') {
                        // Applies the k8s manifest
                        sh 'kubectl apply -f formation-service-deployment.yaml || true'
                        
                        // Updates the deployment with the pulled image tag
                        sh "kubectl set image deployment/formation-service formation-service=${DOCKER_IMAGE}:${DEPLOY_TAG}"
                        
                        // Monitors the rollout
                        sh "kubectl rollout status deployment/formation-service"
                    }
                }
            }
        }
    }
}
