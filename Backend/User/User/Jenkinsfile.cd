pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_VERSION', defaultValue: 'latest', description: 'Tag to deploy')
    }

    environment {
        DOCKER_IMAGE = "azizesp/user-service"
        DEPLOY_TAG = "${params.IMAGE_VERSION}"
    }

    stages {
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Updated path to reflect the folder structure you mentioned.
                    sh "kubectl apply -f Backend/k8s/user-service-deployment.yaml"

                    // Force the deployment to use the specific version
                    sh "kubectl set image deployment/user-service user-service=${DOCKER_IMAGE}:${DEPLOY_TAG}"

                    // Monitor the rollout on your aziz and rima nodes
                    sh "kubectl rollout status deployment/user-service"
                }
            }
        }
    }
    
    post {
        success {
            echo "User Service successfully deployed to the Evermind cluster!!"
        }
        failure {
            echo "Deployment failed. Run 'kubectl get pods' or 'kubectl describe' to troubleshoot."
        }
    }
}