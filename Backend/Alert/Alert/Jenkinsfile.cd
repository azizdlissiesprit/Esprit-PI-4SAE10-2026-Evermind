pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_VERSION', defaultValue: 'latest', description: 'Docker tag to deploy')
    }

    environment {
        DOCKER_IMAGE = "azizesp/alert-service"
        DEPLOY_TAG = "${params.IMAGE_VERSION}"
    }

    stages {
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Points to your K8s manifest folder
                    sh "kubectl apply -f Backend/k8s/alert-service-deployment.yaml"

                    // Updates the image to the one we just built
                    sh "kubectl set image deployment/alert-service alert-service=${DOCKER_IMAGE}:${DEPLOY_TAG}"

                    // Monitors the rollout across aziz and rima
                    sh "kubectl rollout status deployment/alert-service"
                }
            }
        }
    }
}